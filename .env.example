# Public site URL (no trailing slash)
SITE_URL=https://timetozone.com
# "production" enables indexing; anything else => noindex + Disallow: /
SITE_ENV=development
# AdSense publisher id, e.g. ca-pub-1234567890123456 (empty = no ad code at all)
NEXT_PUBLIC_ADSENSE_CLIENT=
# GA4 measurement id, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Chrome Web Store listing URL (enables the extension CTA + Organization sameAs)
NEXT_PUBLIC_CHROME_STORE_URL=
# Shared ISR cache across replicas (Railway Redis plugin). Empty = in-memory cache.
REDIS_URL=
# Long random string, required by POST /api/revalidate
REVALIDATE_SECRET=
# Cloudflare cache purge (cron service only)
CF_ZONE_ID=
CF_API_TOKEN=
# IndexNow key (served at /{key}.txt)
INDEXNOW_KEY=
# Search Console HTML-tag verification token (content="...")
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools verification token (msvalidate.01)
BING_SITE_VERIFICATION=
