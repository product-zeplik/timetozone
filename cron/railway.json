{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "cron/Dockerfile"
  },
  "deploy": {
    "startCommand": "node scripts/dst-watch.mjs",
    "cronSchedule": "5 0 * * *",
    "restartPolicyType": "NEVER",
    "numReplicas": 1
  }
}
