{
  "name": "timetozone",
  "version": "1.0.0",
  "private": true,
  "description": "TimeToZone.com - the fastest, most correct time zone converter on the web.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "data": "node scripts/with-tzdata.mjs node scripts/build-data.mjs && node scripts/with-tzdata.mjs node scripts/build-favicon.mjs",
    "dev": "npm run data && node scripts/with-tzdata.mjs next dev",
    "build": "npm run data && node scripts/with-tzdata.mjs next build",
    "start": "node scripts/with-tzdata.mjs next start",
    "test": "node scripts/with-tzdata.mjs vitest run",
    "test:watch": "node scripts/with-tzdata.mjs vitest",
    "seo:lint": "node scripts/seo-lint.mjs",
    "content-dates": "node scripts/content-dates.mjs",
    "content-dates:check": "node scripts/content-dates.mjs --check",
    "smoke": "node scripts/with-tzdata.mjs node scripts/smoke.mjs",
    "audit:visual": "node scripts/visual-audit.mjs",
    "audit:links": "node scripts/link-audit.mjs",
    "audit:lighthouse": "node scripts/lighthouse.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "dst:watch": "node scripts/with-tzdata.mjs node scripts/dst-watch.mjs",
    "purge": "node scripts/purge-cdn.mjs",
    "ext:build": "node extension/build.mjs",
    "typecheck": "tsc --noEmit",
    "check:adsense": "node scripts/adsense-check.mjs",
    "rank": "node scripts/rank-report.mjs",
    "indexnow:all": "node scripts/indexnow-all.mjs",
    "tzdata:update": "node scripts/update-tzdata.mjs",
    "audit:offsets": "node scripts/with-tzdata.mjs node scripts/offset-audit.mjs",
    "verify:live": "node scripts/with-tzdata.mjs node scripts/verify-live.mjs"
  },
  "dependencies": {
    "@zeplik/core": "file:vendor/zeplik/zeplik-core-0.1.0.tgz",
    "@zeplik/seo-kit": "file:vendor/zeplik/zeplik-seo-kit-0.1.0.tgz",
    "d3-geo": "^3.1.1",
    "i18n-iso-countries": "^7.14.0",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "redis": "^4.7.0",
    "topojson-client": "^3.1.0",
    "topojson-simplify": "^3.0.3",
    "us-atlas": "^3.0.1",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/topojson-client": "^3.1.5",
    "@zeplik/seo-check": "file:vendor/zeplik/zeplik-seo-check-0.1.0.tgz",
    "city-timezones": "^1.2.1",
    "countries-and-timezones": "^3.6.0",
    "esbuild": "^0.24.0",
    "lighthouse": "^12.2.1",
    "playwright": "^1.49.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "@zeplik/core": "$@zeplik/core"
  }
}
